#!/usr/bin/python3
# winv - Windows-style (Win+V) clipboard history for Linux.
#
# One background process watches the clipboard and keeps the last 25 text /
# image entries. Super+V (or `winv --toggle`) opens a Windows 11 style panel
# with clipboard history plus emoji, kaomoji and symbol pickers (Super+.);
# picking something pastes it into the window you were working in.

import os
import sys

VERSION = "1.1.0"
APP_ID = "io.github.winv.ClipboardHistory"

USAGE = """winv %s - Win+V style clipboard history

usage: winv [option]

  (no option)       start the background service (no-op if already running)
  --toggle          show / hide the clipboard history (bind this to Super+V)
  --emoji           show / hide the emoji picker      (bind this to Super+.)
  --show, --hide    show or hide the panel
  --clear           remove every entry that is not pinned
  --quit            stop the background service
  --setup-hotkey    bind Super+V and Super+. on GNOME-based desktops
  --remove-hotkey   undo --setup-hotkey
  --version, --help
""" % VERSION

REMOTE_COMMANDS = ("--toggle", "--emoji", "--show", "--hide", "--clear", "--quit")

if __name__ == "__main__":
    _args = sys.argv[1:]
    if "--help" in _args or "-h" in _args:
        print(USAGE)
        sys.exit(0)
    if "--version" in _args:
        print("winv " + VERSION)
        sys.exit(0)
    _known = REMOTE_COMMANDS + ("--setup-hotkey", "--remove-hotkey")
    _bad = [a for a in _args if a not in _known]
    if _bad:
        sys.stderr.write("winv: unknown option %s\n\n%s" % (_bad[0], USAGE))
        sys.exit(2)

