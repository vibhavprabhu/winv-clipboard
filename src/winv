class GridPage(Gtk.Box):
    """A tab with a grid of things to insert and a category bar, like the
    emoji, kaomoji and symbols tabs of the Windows 11 panel."""

    MAX_RESULTS = 240

    def __init__(self, panel, kind, categories, per_line):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.panel = panel
        self.kind = kind
        self.categories = categories      # [(icon, title, items_fn)]
        self.current = 0
        self.get_style_context().add_class("winv-grid-" + kind)

        self.title = Gtk.Label(xalign=0)
        self.title.get_style_context().add_class("winv-section")
        self.pack_start(self.title, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll = scroll
        self.flow = Gtk.FlowBox()
        self.flow.set_homogeneous(True)
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_min_children_per_line(per_line)
        self.flow.set_max_children_per_line(per_line)
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_activate_on_single_click(True)
        self.flow.connect("child-activated",
                          lambda _f, child: panel.app.insert_text(child.text, kind))
        scroll.add(self.flow)
        self.pack_start(scroll, True, True, 0)

        self.empty = Gtk.Label(label="No results")
        self.empty.get_style_context().add_class("winv-empty")
        self.empty.set_no_show_all(True)
        self.pack_start(self.empty, True, True, 0)

        bar = Gtk.Box(spacing=2)
        bar.get_style_context().add_class("winv-catbar")
        bar.set_halign(Gtk.Align.CENTER)
        self.cat_buttons = []
        for i, (icon, title, _fn) in enumerate(categories):
            btn = Gtk.Button(label=icon)
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.set_can_focus(False)
            btn.set_tooltip_text(title)
            btn.connect("clicked", lambda _b, i=i: self.show_category(i))
            bar.pack_start(btn, False, False, 0)
            self.cat_buttons.append(btn)
        self.pack_end(bar, False, False, 0)

    def _fill(self, items):
        for child in self.flow.get_children():
            self.flow.remove(child)
        for text, name, _kw in items:
            label = Gtk.Label(label=text)
            label.set_ellipsize(Pango.EllipsizeMode.END)
            label.set_max_width_chars(14)    # keeps long kaomoji from widening the grid
            child = Gtk.FlowBoxChild()
            child.text = text
            child.add(label)
            if name:
                child.set_tooltip_text(name)
            self.flow.add(child)
        self.flow.show_all()
        self.empty.set_visible(not items)
        self.scroll.set_visible(bool(items))
        self.scroll.get_vadjustment().set_value(0)

    def show_category(self, index):
        items = self.categories[index][2]()
        if not items and index == 0 and len(self.categories) > 1 \
                and self.categories[0][1] == "Recently used":
            index, items = 1, self.categories[1][2]()
        self.current = index
        for i, btn in enumerate(self.cat_buttons):
            ctx = btn.get_style_context()
            (ctx.add_class if i == index else ctx.remove_class)("active")
        self.title.set_text(self.categories[index][1])
        self._fill(items)

    def search(self, query):
        if not query:
            self.show_category(self.current)
            return
        words = query.split()
        seen, scored = set(), []
        for _icon, title, fn in self.categories:
            if title == "Recently used":
                continue
            for entry in fn():
                text, name, kw = entry
                if text in seen:
                    continue
                name = name.lower()
                # every typed word must start a word of the name or keywords
                # ("cat" finds "cat face", not "communication")
                name_words = WORD_SPLIT.split(name)
                all_words = name_words + WORD_SPLIT.split(kw.lower()) + [text]
                if not all(any(t.startswith(w) for t in all_words) for w in words):
                    continue
                seen.add(text)
                # best first: exact name, name starts with it, all words in
                # the name, then keyword-only matches
                if name == query:
                    rank = 0
                elif name.startswith(query):
                    rank = 1
                elif all(any(t.startswith(w) for t in name_words) for w in words):
                    rank = 2
                else:
                    rank = 3
                scored.append((rank, len(scored), entry))
        scored.sort()
        results = [entry for _r, _i, entry in scored[:self.MAX_RESULTS]]
        for btn in self.cat_buttons:
            btn.get_style_context().remove_class("active")
        self.title.set_text("Search results")
        self._fill(results)

    def activate_first(self):
        children = self.flow.get_children()
        if children:
            self.panel.app.insert_text(children[0].text, self.kind)


