        clear.get_style_context().add_class("text")
        clear.set_relief(Gtk.ReliefStyle.NONE)
        clear.set_can_focus(False)
        clear.set_tooltip_text("Remove everything except pinned items")
        clear.connect("clicked", lambda *_: self.app.clear_history())
        actions.pack_start(clear, False, False, 0)
        actions.show_all()
        actions.set_no_show_all(True)
        actions.hide()

        def expand(btn):
            btn.hide()
            actions.show()
        more = self._icon_button("view-more-horizontal-symbolic", "\u22ef", "See more", expand)
        more.set_halign(Gtk.Align.END)
        side.pack_start(more, False, False, 0)
        side.pack_start(actions, False, False, 0)

        pin = self._icon_button("view-pin-symbolic", "\u2605",
                                "Unpin" if item.pinned else "Pin",
                                lambda *_: self.app.toggle_pin(item))
