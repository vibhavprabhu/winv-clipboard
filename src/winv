    # -- tabs and search

    def show_tab(self, tab):
        self.tab = tab
        for tab_id, btn in self.tab_buttons.items():
            ctx = btn.get_style_context()
            (ctx.add_class if tab_id == tab else ctx.remove_class)("active")
        self.stack.set_visible_child_name(tab)
        self.search.set_placeholder_text(
            "Search clipboard" if tab == "clipboard" else "Search " + tab)
        if self.search.get_text():
            self.search.set_text("")      # triggers _on_search
        else:
            self._apply_query()
        if tab == "clipboard":
            row = self.listbox.get_selected_row()
            if row is not None and self.get_visible():
                row.grab_focus()
        elif self.get_visible():
            self.search.grab_focus_without_selecting()

    def _on_search(self, entry):
        self.query = entry.get_text().strip().lower()
        self._apply_query()

    def _apply_query(self):
        if self.tab == "clipboard":
            self.listbox.invalidate_filter()
            self.clip_title.set_text("Search results" if self.query else "Clipboard")
            for row in self.listbox.get_children():
                if self._clip_filter(row):
                    self.listbox.select_row(row)
                    break
        else:
            self.pages[self.tab].search(self.query)

    def _clip_filter(self, row):
        if not self.query:
            return True
        item = row.item
        return item.kind == "text" and self.query in item.text.lower()

    def _on_search_activate(self, _entry):
        if self.tab == "clipboard":
            row = self.listbox.get_selected_row()
            if row is not None and self._clip_filter(row):
                self.app.paste_item(row.item)
        else:
            self.pages[self.tab].activate_first()

    # -- rows

    def _icon_button(self, icon, fallback, tooltip, handler):
        btn = Gtk.Button()
        try:    # the icon may be missing, or the theme may lack an SVG loader
            Gtk.IconTheme.get_default().load_icon(icon, 16, 0)
            btn.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU))
        except GLib.Error:
            btn.set_label(fallback)
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_can_focus(False)
        btn.set_tooltip_text(tooltip)
        btn.connect("clicked", handler)
        return btn

    def _make_row(self, item):
        row = Gtk.ListBoxRow()
        row.item = item
        row.get_style_context().add_class("winv-row")
        box = Gtk.Box(spacing=6)
        if item.kind == "text":
            body = Gtk.Label(label=item.text.strip()[:600] or item.text[:600], xalign=0, yalign=0)
            body.set_line_wrap(True)
            body.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            body.set_lines(4)
            body.set_ellipsize(Pango.EllipsizeMode.END)
            body.set_width_chars(20)
            body.set_max_width_chars(30)
        else:
            if item.thumb is None:
                w, h = item.pixbuf.get_width(), item.pixbuf.get_height()
                scale = min(1.0, 290.0 / w, 120.0 / h)
                item.thumb = item.pixbuf.scale_simple(
                    max(1, int(w * scale)), max(1, int(h * scale)),
                    GdkPixbuf.InterpType.BILINEAR)
            body = Gtk.Image.new_from_pixbuf(item.thumb)
            body.set_halign(Gtk.Align.START)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.pack_start(body, True, True, 0)
        meta = time_ago(item.time)
        if item.kind == "image":
            meta += "  ·  %d × %d" % (item.pixbuf.get_width(), item.pixbuf.get_height())
        meta_label = Gtk.Label(label=meta, xalign=0)
        meta_label.get_style_context().add_class("winv-meta")
        content.pack_end(meta_label, False, False, 0)
        box.pack_start(content, True, True, 0)

        # Like Windows 11: "..." top right (expands to Delete / Clear all),
