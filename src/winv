#!/usr/bin/python3
# winv - Windows-style (Win+V) clipboard history for Linux.
#
# One background process watches the clipboard and keeps the last 25 text /
# image entries. Super+V (or `winv --toggle`) opens a panel at the pointer;
# picking an entry puts it back on the clipboard and pastes it into the
# window you were working in.

import os
import sys

VERSION = "1.0.0"
APP_ID = "io.github.winv.ClipboardHistory"

USAGE = """winv %s - Win+V style clipboard history

usage: winv [option]

  (no option)       start the background service (no-op if already running)
  --toggle          show / hide the history panel   (bind this to Super+V)
  --show, --hide    show or hide the panel
  --clear           remove every entry that is not pinned
  --quit            stop the background service
  --setup-hotkey    bind Super+V on GNOME-based desktops
  --remove-hotkey   undo --setup-hotkey
  --version, --help
""" % VERSION

REMOTE_COMMANDS = ("--toggle", "--show", "--hide", "--clear", "--quit")

if __name__ == "__main__":
    _args = sys.argv[1:]
    if "--help" in _args or "-h" in _args:
        print(USAGE)
        sys.exit(0)
    if "--version" in _args:
        print("winv " + VERSION)
        sys.exit(0)
    _known = REMOTE_COMMANDS + ("--setup-hotkey", "--remove-hotkey")
    _bad = [a for a in _args if a not in _known]
    if _bad:
        sys.stderr.write("winv: unknown option %s\n\n%s" % (_bad[0], USAGE))
        sys.exit(2)

WAYLAND = bool(os.environ.get("WAYLAND_DISPLAY")) or \
    os.environ.get("XDG_SESSION_TYPE") == "wayland"
WSL = bool(os.environ.get("WSL_DISTRO_NAME")) or os.path.isdir("/mnt/wslg")

# A background Wayland client is not told about clipboard changes, an X11
# client is. So whenever an X server (Xorg or XWayland) is reachable, use it.
if os.environ.get("DISPLAY") and "GDK_BACKEND" not in os.environ:
    os.environ["GDK_BACKEND"] = "x11"

