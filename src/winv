def load_symbols():
    import unicodedata
    groups = []
    for icon, title, ranges in SYMBOL_GROUPS:
        items = []
        for lo, hi in ranges:
            for c in range(lo, hi + 1):
                name = unicodedata.name(chr(c), "")
                # skip invisible characters (soft hyphen, spaces, controls)
                if name and unicodedata.category(chr(c)) not in ("Cf", "Cc", "Zs", "Zl", "Zp"):
                    items.append((chr(c), name.lower(), ""))
        groups.append((icon, title, items))
    return groups


