def load_emoji():
    """Returns {group: [(text, name, keywords)]}."""
    groups = {}
    try:
        data = Gio.resources_lookup_data("/org/gtk/libgtk/emoji/en.data", 0)
        entries = GLib.Variant.new_from_bytes(
            GLib.VariantType("a(ausasu)"), data, True).unpack()
    except (GLib.Error, TypeError, ValueError):
        entries = []
    for codepoints, name, keywords, group in entries:
        if group == 2:
            continue
        text = "".join(chr(c) for c in codepoints if c)   # 0 = skin tone slot
        if len(text) == 1 and ord(text) < 0x1F000:
            text += "️"    # older symbols like ❤ default to text style without it
        groups.setdefault(group, []).append((text, name, " ".join(keywords)))
    if not groups:   # very old GTK: fall back to the Emoticons block
        import unicodedata
        groups[0] = [(chr(c), unicodedata.name(chr(c), "").lower(), "")
                     for c in range(0x1F600, 0x1F650)]
    return groups


